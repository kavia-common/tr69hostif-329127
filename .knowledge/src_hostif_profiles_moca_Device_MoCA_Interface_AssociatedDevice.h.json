{"is_source_file": true, "format": "C/C++ Header File", "description": "This file defines the API and class interface for managing associated MoCA devices connected to a specific interface. It includes class declarations, getter methods for device properties (like MAC address, NodeID, version, rates, power levels, and active status), and documentation comments describing each function's purpose.", "external_files": ["hostIf_main.h", "hostIf_tr69ReqHandler.h", "hostIf_utils.h", "Device_MoCA_Interface.h"], "external_methods": [], "published": ["MoCAInterfaceAssociatedDevice", "get_MACAddress", "get_NodeID", "get_PreferredNC", "get_HighestVersion", "get_PHYTxRate", "get_PHYRxRate", "get_TxPowerControlReduction", "get_RxPowerLevel", "get_TxBcastRate", "get_RxBcastPowerLevel", "get_TxPackets", "get_RxPackets", "get_RxErroredAndMissedPackets", "get_QAM256Capable", "get_PacketAggregationCapability", "get_RxSNR", "get_Active"], "classes": [{"name": "MoCAInterfaceAssociatedDevice", "description": "Class encapsulating the properties and methods related to an associated MoCA device. It provides getter functions for device-specific parameters such as MAC address, NodeID, highest supported version, rates, power levels, and activity status."}], "methods": [{"name": "get_MACAddress", "description": "Retrieves the MAC address of the associated device's MoCA interface, populating the corresponding TR-069 parameter."}, {"name": "get_NodeID", "description": "Retrieves the Node ID of the remote device based on the mocaNodeIndex."}, {"name": "get_PreferredNC", "description": "Indicates whether the remote device is a preferred Network Coordinator."}, {"name": "get_HighestVersion", "description": "Provides the highest supported MoCA version of the device in dot-delimited format."}, {"name": "get_PHYTxRate", "description": "Fetches the PHY transmit rate in Mbps."}, {"name": "get_PHYRxRate", "description": "Fetches the PHY receive rate in Mbps."}, {"name": "get_TxPowerControlReduction", "de