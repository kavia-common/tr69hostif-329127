{"is_source_file": true, "format": "C/C++ header", "description": "This header file defines the interface for managing throughput statistics of the TR-069 Device.MoCA.Interface.{i}.Stats object. It declares the MoCAInterfaceStats class with methods to retrieve various statistics such as bytes sent/received, packets sent/received, errors, and multicast/broadcast/discard packets. The file includes external dependencies and comments detailing API usage and licensing.", "external_files": ["hostIf_main.h", "hostIf_tr69ReqHandler.h", "hostIf_utils.h", "Device_MoCA_Interface.h"], "external_methods": [], "published": ["MoCAInterfaceStats"], "classes": [{"name": "MoCAInterfaceStats", "description": "Class providing getter methods for throughput statistics of the MoCA interface, implementing singleton pattern for instance management."}], "methods": [{"name": "get_BytesSent", "description": "Retrieves the total number of bytes transmitted out of the MoCA interface, including framing characters."}, {"name": "get_BytesReceived", "description": "Retrieves the total number of bytes received on the MoCA interface, including framing characters."}, {"name": "get_PacketsSent", "description": "Retrieves the total number of packets transmitted out of the MoCA interface."}, {"name": "get_PacketsReceived", "description": "Retrieves the total number of packets received on the MoCA interface."}, {"name": "get_ErrorsSent", "description": "Retrieves the number of outbound packets that could not be transmitted because of errors."}, {"name": "get_ErrorsReceived", "description": "Retrieves the number of inbound packets that contained errors preventing delivery to a higher-layer protocol."}, {"name": "get_UnicastPacketsSent", "description": "Retrieves the number of unicast packets sent, not addressed to multicast or broadcast."}, {"name": "get_UnicastPacketsReceived", "description": "Retrieves the number of unicast packets received that were delivered to a higher layer."}, {"name": "get_DiscardPacketsSent", "description": "Retrieves the number of outbound packets discarded, despite no errors."}, {"name": "get_DiscardPacketsReceived", "description": "Retrieves the number of inbound packets discarded, despite no errors."}, {"name": "get_MulticastPacketsSent", "description": "Retrieves the number of multicast packets transmitted."}, {"name": "get_MulticastPacketsReceived", "description": "Retrieves the number of multicast packets received."}, {"name": "get_BroadcastPacketsSent", "description": "Retrieves the number of broadcast packets transmitted."}, {"name": "get_BroadcastPacketsReceived", "description": "Retrieves the number of broadcast packets received."}, {"name": "get_UnknownProtoPacketsReceived", "description": "Retrieves the number of packets received with unknown or unsupported protocol."}, {"name": "~MoCAInterfaceStats()", "scope": "MoCAInterfaceStats", "scopeKind": "class", "description": "unavailable"}], "search-terms": ["MoCA", "Device.MoCA.Interface.Stats", "Stats", "getInstance", "hostIf"], "state": 2, "file_id": 298, "knowledge_revision": 1030, "git_revision": "db913d7e78c379f68c2743350abf00b185314946", "ctags": [{"_type": "tag", "name": "HOSTIF_MOCA_INTERFACE_STATS_H_", "path": "/home/kavia/workspace/code-generation/tr69hostif-329127/src/hostif/profiles/moca/Device_MoCA_Interface_Stats.h", "pattern": "/^#define HOSTIF_MOCA_INTERFACE_STATS_H_$/", "language": "C++", "kind": "macro"}, {"_type": "tag", "name": "MoCAInterfaceStats", "path": "/home/kavia/workspace/code-generation/tr69hostif-329127/src/hostif/profiles/moca/Device_MoCA_Interface_Stats.h", "pattern": "/^class MoCAInterfaceStats {$/", "language": "C++", "kind": "class"}, {"_type": "tag", "name": "m_i32DevID", "path": "/home/kavia/workspace/code-generation/tr69hostif-329127/src/hostif/profiles/moca/Device_MoCA_Interface_Stats.h", "pattern": "/^    int                     m_i32DevID;$/", "language": "C++", "typeref": "typename:int", "kind": "member", "scope": "MoCAInterfaceStats", "scope